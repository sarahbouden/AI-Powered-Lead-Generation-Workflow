    {
      "parameters": {
        "jsCode": "// Get all items\nreturn $input.all().map(item => {\n  const profile = item.json.profile || {};\n  \n  // Phone parsing\n  let phone = '';\n  if (profile.phone) {\n    phone = profile.phone;\n  } else if (Array.isArray(profile.phones) && profile.phones.length > 0) {\n    phone = profile.phones[0];\n  }\n\n  // Email parsing\n  let email = '';\n  if (profile.professionalEmail) {\n    email = profile.professionalEmail;\n  } else if (Array.isArray(profile.professionalEmails) && profile.professionalEmails.length > 0) {\n    email = profile.professionalEmails[0];\n  } else if (Array.isArray(profile.emails) && profile.emails.length > 0 && profile.emails[0].email) {\n    email = profile.emails[0].email;\n  }\n\n  return {\n    json: {\n      phone,\n      email\n    }\n  };\n});\n"
      },
