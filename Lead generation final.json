      "parameters": {
        "jsCode": "const inputItems = $input.all();\nlet nextStartIndex = 1;\nlet hasMoreResults = false;\n\nif (inputItems?.length) {\n  const first = inputItems[0].json || {};\n  \n  // Get current start index or index\n  const idx = Number(first.startIndex ?? first.index ?? 1);\n  \n  // Increment by 10 for next page\n  nextStartIndex = idx + 10;\n  \n  // Continue loop if we're not past Google's limit\n  hasMoreResults = nextStartIndex <= 100 && (first.hasMoreResults ?? true);\n}\n\nreturn {\n  json: {\n    continueLoop: hasMoreResults,\n    startIndex: nextStartIndex\n  }\n};\n"
      },
