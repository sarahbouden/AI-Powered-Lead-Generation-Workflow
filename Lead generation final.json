        "jsCode": "// Get all incoming items\nconst items = $input.all();\n\n// Process each item\nreturn items.map(item => {\n  const url = item.json.linkedin_url || item.json[\"link\"] || \"\";\n  \n  // Extract the part after \"/in/\" and before the next slash (if any)\n  const match = url.match(/linkedin\\.com\\/in\\/([^\\/]+)/i);\n  \n  // If match found, take first group as the LinkedIn ID\n  const linkedinId = match ? match[1] : null;\n  \n  return {\n    json: {\n      ...item.json,\n      linkedin_id: linkedinId\n    }\n  };\n});\n"
      },
